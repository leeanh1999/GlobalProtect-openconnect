#include <winres.h>

#define RT_MANIFEST_ID 24

1 RT_MANIFEST_ID "app.manifest"

#ifdef HAVE_APP_ICON
1 ICON "app.ico"
#endif

VS_VERSION_INFO VERSIONINFO
FILEFLAGSMASK 0x3fL
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "GlobalProtect-openconnect contributors"
      VALUE "FileDescription", "GlobalProtect VPN"
      VALUE "InternalName", "gpgui-win"
      VALUE "LegalCopyright", "GPL-3.0"
      VALUE "OriginalFilename", "gpgui-win.exe"
      VALUE "ProductName", "GlobalProtect VPN"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
